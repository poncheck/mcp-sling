# Sling API Configuration

# RECOMMENDED: Use a pre-obtained token from your browser (avoids captcha issues)
# See TOKEN_GUIDE.md for instructions on how to get your token
SLING_TOKEN=your-token-here

# ALTERNATIVE: Email and password (currently requires captcha - not recommended)
# SLING_EMAIL=your-email@example.com
# SLING_PASSWORD=your-password

# Optional: Server configuration
SLING_SERVER=api
# Use test-api for staging environment:
# SLING_SERVER=test-api
